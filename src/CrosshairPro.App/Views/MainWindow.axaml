<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CrosshairPro.App.ViewModels"
        xmlns:controls="using:CrosshairPro.App.Controls"
        x:Class="CrosshairPro.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CrosshairPro - CS2 准星工具"
        Width="900" Height="650"
        MinWidth="800" MinHeight="550">
  <Design.DataContext>
    <vm:MainViewModel/>
  </Design.DataContext>

  <Grid RowDefinitions="Auto, *, Auto">
    <!-- 顶部状态栏 -->
    <Border Grid.Row="0" Background="{DynamicResource AppHeaderBackground}" Padding="15,10">
      <Grid ColumnDefinitions="Auto, *, Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock Text="CrosshairPro" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppAccentColor}"/>
          <TextBlock Text="{Binding AppVersion}" FontSize="12" Foreground="{DynamicResource AppTextMuted}" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{DynamicResource AppTextSecondary}"/>
          <Button Content="显示/隐藏准星" Command="{Binding ToggleCrosshairCommand}" Classes="Accent"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主体内容 -->
    <TabControl Grid.Row="1" Margin="10" SelectedIndex="{Binding SelectedTabIndex}">

      <!-- 标签页1：准星设置 -->
      <TabItem Header="准星设置">
        <Grid Margin="5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- 左侧：预设列表 -->
          <Border Grid.Column="0" CornerRadius="8" Padding="10" Background="{DynamicResource AppSurfaceBackground}">
            <Grid RowDefinitions="Auto, *, Auto">
              <TextBlock Grid.Row="0" Text="预设列表" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

              <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="8">
                  <TextBlock Text="内置预设" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMuted}" Margin="0,5,0,3"/>
                  <ItemsControl ItemsSource="{Binding BuiltInPresets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="{Binding Name}"
                                Command="{Binding $parent[Window].DataContext.ApplyPresetCommand}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Margin="0,2"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>

              <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="5">
                <Button Content="保存当前为预设" Command="{Binding SavePresetCommand}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- 右侧：准星设置面板 -->
          <Border Grid.Column="1" CornerRadius="8" Padding="15" Background="{DynamicResource AppSurfaceBackground}" Margin="10,0,0,0">
            <ScrollViewer>
              <StackPanel Spacing="15">
                <TextBlock Text="准星设置" FontSize="18" FontWeight="Bold"/>

                <!-- 准星预览 -->
                <Border Background="{DynamicResource AppSurfaceDark}" CornerRadius="8" Padding="15" HorizontalAlignment="Center">
                  <controls:CrosshairPreview Width="200" Height="200" Settings="{Binding CrosshairSettings}"/>
                </Border>

                <!-- 基本设置 -->
                <TextBlock Text="基本设置" FontWeight="SemiBold" FontSize="14"/>

                <Grid ColumnDefinitions="*, *">
                  <StackPanel Spacing="5" Margin="0,0,7,0">
                    <TextBlock Text="准星大小"/>
                    <Slider Value="{Binding CrosshairSettings.Size, Mode=TwoWay}" Minimum="0.5" Maximum="10" SmallChange="0.1" LargeChange="0.5"/>
                    <TextBlock Text="{Binding CrosshairSettings.Size}" HorizontalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Spacing="5" Grid.Column="1" Margin="7,0,0,0">
                    <TextBlock Text="线条粗细"/>
                    <Slider Value="{Binding CrosshairSettings.Thickness, Mode=TwoWay}" Minimum="0.5" Maximum="5" SmallChange="0.1" LargeChange="0.5"/>
                    <TextBlock Text="{Binding CrosshairSettings.Thickness}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*, *">
                  <StackPanel Spacing="5" Margin="0,0,7,0">
                    <TextBlock Text="间隙"/>
                    <Slider Value="{Binding CrosshairSettings.Gap, Mode=TwoWay}" Minimum="-5" Maximum="10" SmallChange="0.1" LargeChange="1"/>
                    <TextBlock Text="{Binding CrosshairSettings.Gap}" HorizontalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Spacing="5" Grid.Column="1" Margin="7,0,0,0">
                    <TextBlock Text="中心点大小"/>
                    <Slider Value="{Binding CrosshairSettings.CenterDotSize, Mode=TwoWay}" Minimum="0.5" Maximum="5" SmallChange="0.1" LargeChange="0.5"/>
                    <TextBlock Text="{Binding CrosshairSettings.CenterDotSize}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>

                <!-- 开关选项 -->
                <StackPanel Spacing="8">
                  <CheckBox Content="显示中心点" IsChecked="{Binding CrosshairSettings.HasCenterDot, Mode=TwoWay}"/>
                  <CheckBox Content="T型准星" IsChecked="{Binding CrosshairSettings.IsTShaped, Mode=TwoWay}"/>
                  <CheckBox Content="显示描边" IsChecked="{Binding CrosshairSettings.HasOutline, Mode=TwoWay}"/>
                </StackPanel>

                <!-- 描边厚度 -->
                <StackPanel Spacing="5" IsEnabled="{Binding CrosshairSettings.HasOutline}">
                  <TextBlock Text="描边厚度"/>
                  <Slider Value="{Binding CrosshairSettings.OutlineThickness, Mode=TwoWay}" Minimum="0.5" Maximum="3" SmallChange="0.1" LargeChange="0.5"/>
                  <TextBlock Text="{Binding CrosshairSettings.OutlineThickness}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 颜色设置 -->
                <TextBlock Text="颜色设置" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0"/>

                <StackPanel Spacing="8">
                  <TextBlock Text="预设颜色"/>
                  <ComboBox ItemsSource="{Binding ColorPresets}"
                            SelectedItem="{Binding CrosshairSettings.ColorPreset, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <Grid ColumnDefinitions="*, *, *">
                  <StackPanel Spacing="5" Margin="0,0,5,0">
                    <TextBlock Text="R"/>
                    <TextBox Text="{Binding CrosshairSettings.ColorR, Mode=TwoWay}"/>
                  </StackPanel>
                  <StackPanel Spacing="5" Grid.Column="1" Margin="5,0">
                    <TextBlock Text="G"/>
                    <TextBox Text="{Binding CrosshairSettings.ColorG, Mode=TwoWay}"/>
                  </StackPanel>
                  <StackPanel Spacing="5" Grid.Column="2" Margin="5,0,0,0">
                    <TextBlock Text="B"/>
                    <TextBox Text="{Binding CrosshairSettings.ColorB, Mode=TwoWay}"/>
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="5">
                  <TextBlock Text="透明度"/>
                  <Slider Value="{Binding CrosshairSettings.Alpha, Mode=TwoWay}" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10"/>
                  <TextBlock Text="{Binding CrosshairSettings.Alpha}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 位置调整 -->
                <TextBlock Text="位置调整" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0"/>

                <StackPanel Spacing="8">
                  <CheckBox Content="开启准星时自动复位到中心" IsChecked="{Binding AutoResetCrosshairPosition, Mode=TwoWay}"/>
                  <CheckBox Content="启用拖动调整（按住热键拖动准星）" IsChecked="{Binding EnableDragCrosshair, Mode=TwoWay}"/>
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="水平偏移" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,5"/>
                    <Slider Value="{Binding CrosshairOffsetX, Mode=TwoWay}" Minimum="-200" Maximum="200" SmallChange="1" LargeChange="10" Grid.Row="0" Grid.Column="1" Margin="0,0,5,5"/>
                    <TextBlock Text="{Binding CrosshairOffsetX}" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" MinWidth="40" TextAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="垂直偏移" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,0"/>
                    <Slider Value="{Binding CrosshairOffsetY, Mode=TwoWay}" Minimum="-200" Maximum="200" SmallChange="1" LargeChange="10" Grid.Row="1" Grid.Column="1" Margin="0,5,5,0"/>
                    <TextBlock Text="{Binding CrosshairOffsetY}" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" MinWidth="40" TextAlignment="Center" Margin="0,5,0,0"/>
                  </Grid>
                  <Button Content="重置到屏幕中心" Command="{Binding ResetCrosshairPositionCommand}" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- CS2 代码导入导出 -->
                <TextBlock Text="CS2 代码" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0"/>

                <StackPanel Spacing="8">
                  <TextBox Text="{Binding ImportCode, Mode=TwoWay}"
                           Watermark="粘贴 CS2 准星代码（sharecode 或 cl_crosshair* 命令）"
                           AcceptsReturn="True" TextWrapping="Wrap"
                           Height="60"/>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="导入代码" Command="{Binding ImportFromCodeCommand}" Classes="Accent"/>
                    <Button Content="导出代码" Command="{Binding ExportCurrentCodeCommand}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding ExportedCode}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondary}"/>
                </StackPanel>

                <!-- 快捷键说明 -->
                <TextBlock Text="提示：可在窗口设置中配置热键快速开关准星" Foreground="{DynamicResource AppTextMuted}" FontSize="12" Margin="0,10,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- 标签页2：窗口设置 -->
      <TabItem Header="窗口设置">
        <ScrollViewer Padding="15">
          <StackPanel Spacing="20">
            <TextBlock Text="窗口设置" FontSize="18" FontWeight="Bold"/>

            <!-- 显示设置 -->
            <Border Background="{DynamicResource AppSurfaceBackground}" CornerRadius="8" Padding="15">
              <StackPanel Spacing="12">
                <TextBlock Text="显示设置" FontWeight="SemiBold" FontSize="14"/>

                <CheckBox Content="窗口始终置顶" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"/>
                <CheckBox Content="在任务栏显示图标" IsChecked="{Binding ShowInTaskbar, Mode=TwoWay}"/>
                <CheckBox Content="最小化到系统托盘" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"/>
                <CheckBox Content="启动时最小化" IsChecked="{Binding StartMinimized, Mode=TwoWay}"/>
                <CheckBox Content="开机自动启动" IsChecked="{Binding AutoStart, Mode=TwoWay}"/>

                <StackPanel Spacing="5" Margin="0,5,0,0">
                  <TextBlock Text="窗口透明度"/>
                  <Slider Value="{Binding WindowOpacity, Mode=TwoWay}" Minimum="0.3" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"/>
                  <TextBlock Text="{Binding WindowOpacity}" HorizontalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 准星显示设置 -->
            <Border Background="{DynamicResource AppSurfaceBackground}" CornerRadius="8" Padding="15">
              <StackPanel Spacing="12">
                <TextBlock Text="准星显示" FontWeight="SemiBold" FontSize="14"/>

                <StackPanel Spacing="5">
                  <TextBlock Text="准星缩放倍率"/>
                  <Slider Value="{Binding CrosshairScale, Mode=TwoWay}" Minimum="0.5" Maximum="3.0" SmallChange="0.1" LargeChange="0.5"/>
                  <TextBlock Text="{Binding CrosshairScale}" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Spacing="5" Margin="0,5,0,0">
                  <TextBlock Text="显示显示器"/>
                  <ComboBox ItemsSource="{Binding MonitorOptions}" SelectedIndex="0"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 鼠标设置 -->
            <Border Background="{DynamicResource AppSurfaceBackground}" CornerRadius="8" Padding="15">
              <StackPanel Spacing="12">
                <TextBlock Text="热键设置" FontWeight="SemiBold" FontSize="14"/>

                <CheckBox Content="启用鼠标热键" IsChecked="{Binding EnableMouseHook, Mode=TwoWay}"/>

                <StackPanel Spacing="8" IsEnabled="{Binding EnableMouseHook}">

                  <StackPanel Spacing="5">
                    <TextBlock Text="触发按键"/>
                    <ComboBox ItemsSource="{Binding AllHotkeyDisplayOptions}" SelectedIndex="{Binding SelectedHotkeyIndex, Mode=TwoWay}"/>
                  </StackPanel>

                  <StackPanel Spacing="5">
                    <TextBlock Text="触发方式"/>
                    <ComboBox ItemsSource="{Binding TriggerModeOptions}" SelectedIndex="{Binding SelectedTriggerModeIndex, Mode=TwoWay}"/>
                  </StackPanel>

                  <StackPanel Spacing="5" IsVisible="{Binding IsLongPressMode}">
                    <TextBlock Text="时间阈值（毫秒）"/>
                    <Slider Value="{Binding RightClickHoldThresholdMs, Mode=TwoWay}" Minimum="100" Maximum="2000" SmallChange="50" LargeChange="100"/>
                    <TextBlock Text="{Binding RightClickHoldThresholdMs}" HorizontalAlignment="Center"/>
                  </StackPanel>

                  <StackPanel Spacing="5" IsVisible="{Binding !IsLongPressMode}">
                    <TextBlock Text="连击次数"/>
                    <Slider Value="{Binding HotkeyClickCount, Mode=TwoWay}" Minimum="2" Maximum="5" SmallChange="1" LargeChange="1"/>
                    <TextBlock Text="{Binding HotkeyClickCount}" HorizontalAlignment="Center"/>
                  </StackPanel>

                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 外观设置 -->
            <Border Background="{DynamicResource AppSurfaceBackground}" CornerRadius="8" Padding="15">
              <StackPanel Spacing="12">
                <TextBlock Text="外观设置" FontWeight="SemiBold" FontSize="14"/>

                <StackPanel Spacing="5">
                  <TextBlock Text="主题"/>
                  <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Spacing="5" Margin="0,5,0,0">
                  <TextBlock Text="语言"/>
                  <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedIndex="0"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Background="{DynamicResource AppSurfaceBackground}" CornerRadius="8" Padding="15">
              <StackPanel Spacing="12">
                <TextBlock Text="关于" FontWeight="SemiBold" FontSize="14"/>
                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto">
                  <Image Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Width="60" Height="60" Margin="0,0,15,0" Name="DeveloperAvatar">
                    <Image.Clip>
                      <EllipseGeometry RadiusX="30" RadiusY="30" Center="30,30"/>
                    </Image.Clip>
                  </Image>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="版本：" Foreground="{DynamicResource AppTextMuted}"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" Margin="50,0,0,0"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="开发者：" Foreground="{DynamicResource AppTextMuted}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeveloperName}" Margin="50,0,0,0"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="GitHub：" Foreground="{DynamicResource AppTextMuted}"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeveloperGithub}" Foreground="{DynamicResource AppAccentColor}" Margin="50,0,0,0"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 重置设置 -->
            <Border Background="{DynamicResource AppSurfaceBackground}" CornerRadius="8" Padding="15">
              <StackPanel Spacing="12">
                <TextBlock Text="重置" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="重置所有设置为默认值" Foreground="{DynamicResource AppTextMuted}" FontSize="12"/>
                <Button Content="重置所有设置" Command="{Binding ResetSettingsCommand}"
                        Background="{DynamicResource AppDangerColor}" Foreground="White" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <!-- 底部状态栏 -->
    <Border Grid.Row="2" Background="{DynamicResource AppHeaderBackground}" Padding="15,8">
      <TextBlock Text="CrosshairPro © 2024 | 准星覆盖工具" Foreground="{DynamicResource AppTextMuted}" FontSize="11" HorizontalAlignment="Center"/>
    </Border>
  </Grid>
</Window>
