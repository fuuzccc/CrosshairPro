<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <Color x:Key="AppHeaderBackground">#FF0F172A</Color>
        <Color x:Key="AppSurfaceBackground">#FF111827</Color>
        <Color x:Key="AppSurfaceDark">#FF0A0E17</Color>
        <Color x:Key="AppAccentColor">#FF00D4FF</Color>
        <Color x:Key="AppTextMuted">#FF64748B</Color>
        <Color x:Key="AppTextSecondary">#FF94A3B8</Color>
        <Color x:Key="AppDangerColor">#FFEF4444</Color>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="#FF0A0E17" />
        <Setter Property="Foreground" Value="#FFE2E8F0" />
        <Setter Property="BorderBrush" Value="#FF2D3F54" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border">
        <Setter Property="BorderBrush" Value="#FF2D3F54" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="#FFE2E8F0" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="#FF1A2332" />
        <Setter Property="Foreground" Value="#FFE2E8F0" />
        <Setter Property="BorderBrush" Value="#FF2D3F54" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="#FF1E3A5F" />
        <Setter Property="BorderBrush" Value="#FF00D4FF" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="#FF0F172A" />
    </Style>

    <Style Selector="Button.Accent">
        <Setter Property="Background" Value="#FF00D4FF" />
        <Setter Property="Foreground" Value="#FF0F172A" />
        <Setter Property="BorderBrush" Value="#FF00D4FF" />
    </Style>

    <Style Selector="Button.Accent:pointerover">
        <Setter Property="Background" Value="#FF67E8F9" />
        <Setter Property="Foreground" Value="#FF0F172A" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#FFE2E8F0" />
    </Style>

    <Style Selector="Slider">
        <Setter Property="Foreground" Value="#FF00D4FF" />
        <Setter Property="BorderBrush" Value="#FF2D3F54" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="#FF111827" />
        <Setter Property="Foreground" Value="#FFE2E8F0" />
        <Setter Property="BorderBrush" Value="#FF2D3F54" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="#FF00D4FF" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#FF111827" />
        <Setter Property="Foreground" Value="#FFE2E8F0" />
        <Setter Property="BorderBrush" Value="#FF2D3F54" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="#FF00D4FF" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="#FF111827" />
        <Setter Property="Foreground" Value="#FFE2E8F0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="#FF1E3A5F" />
    </Style>

    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="#FF94A3B8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="Margin" Value="0,0,2,0" />
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="#FF00D4FF" />
        <Setter Property="BorderBrush" Value="#FF00D4FF" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>

    <Style Selector="TabItem:pointerover">
        <Setter Property="Foreground" Value="#FFE2E8F0" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="#FF111827" />
    </Style>

    <Style Selector="ItemsControl">
        <Setter Property="Background" Value="Transparent" />
    </Style>

</Styles>
